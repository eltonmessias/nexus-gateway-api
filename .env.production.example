# ── Copy to `.env` and fill in. NEVER commit the real .env. ──────────────────

# Public domain that points (DNS A record) to this server. Caddy gets TLS for it.
API_DOMAIN=api.yourdomain.com

# Database
DB_NAME=nexus
DB_USERNAME=nexus
# Use a long random password:  openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_strong_db_password

# Redis (optional password; leave empty to disable auth)
REDIS_PASSWORD=

# JWT signing secret — MUST be replaced. The default in application.yml is public.
# Generate 64 hex bytes:  openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64

# Front-end origin(s) allowed to call the API (comma-separated, no trailing slash).
# e.g. your Vercel URL:
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
